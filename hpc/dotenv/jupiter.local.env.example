# Per-user Jupiter overlay — TEMPLATE.
#   cp hpc/dotenv/jupiter.local.env.example hpc/dotenv/jupiter.local.env   # gitignored
# and fill in. Loaded AFTER jupiter.env (same parser, later wins) by
# hpc.set_environment (launcher) and by the RL sbatch, so you never edit the
# tracked jupiter.env to point at your own scratch / venv. Uncomment what you
# need; anything left commented keeps the jupiter.env / hpc.py value.

# --- Own scratch tree (jupiter.env assumes /e/scratch/jureap59/$USER) -------
# export SCRATCH=/e/fscratch/<project>/$USER
# export DCFT=$SCRATCH/OpenThoughts-Agent
# export DCFT_DATA=$SCRATCH/data
# export DCFT_SCRATCH=$SCRATCH/otagent
# export DCFT_GROUP=<slurm account>
# export DC_AGENT_SECRET_ENV=$SCRATCH/keys/secrets.env
# export HF_HOME=$SCRATCH/cache/hf
# export HF_HUB_CACHE=$SCRATCH/hf_hub
# export CHECKPOINTS_DIR=$SCRATCH/checkpoints
# export DATASETS_DIR=$SCRATCH/data
# export VLLM_CACHE_ROOT=$SCRATCH/cache/vllm
# export XDG_CACHE_HOME=$SCRATCH/cache/xdg
# export TRITON_CACHE_DIR=$SCRATCH/cache/triton
# export TORCHINDUCTOR_CACHE_DIR=$SCRATCH/cache/torchinductor
# export FLASHINFER_WORKSPACE_BASE=$SCRATCH/cache/flashinfer
# export WANDB_DIR=$SCRATCH/wandb

# --- Overrides of hpc.py jupiter defaults (the defaults are feuer1's paths) --
# export OT_AGENT_RAY_LOG_DIR=$SCRATCH/experiments/_ray_logs
# export OT_AGENT_RAY_SPILL_DIR=$SCRATCH/ray_spill
# Set (even empty) to replace the conda_activate line in the sbatch — use empty
# when the RL runtime is a host venv (DCFT_RL_ENV) and no conda is needed:
# export DCFT_CONDA_ACTIVATE=

# --- Host-venv RL runtime (no Apptainer SIF) ---------------------------------
# Build with hpc/env_builds/jupiter/build_rl_fa_env.sh. Empty IMAGE => the RL
# sbatch skips Apptainer. vLLM/torch wheels need the pip nvidia-* libs on
# LD_LIBRARY_PATH even with the CUDA/13 modules loaded.
# export RL_REPO_DIR=$SCRATCH/MarinSkyRL
# export SKYRL_HOME=$RL_REPO_DIR
# export PYTHONPATH="${SKYRL_HOME}/skyrl-train:${SKYRL_HOME}/skyrl-gym:${DCFT}${PYTHONPATH:+:$PYTHONPATH}"
# export DCFT_RL_ENV=$SCRATCH/envs/rl-fa
# export IMAGE=
# _RL_SP=$DCFT_RL_ENV/lib/python3.12/site-packages
# export LD_LIBRARY_PATH=$_RL_SP/nvidia/cu13/lib:$_RL_SP/nvidia/cublas/lib:$_RL_SP/nvidia/cuda_cupti/lib:$_RL_SP/nvidia/cuda_nvrtc/lib:$_RL_SP/nvidia/cuda_runtime/lib:$_RL_SP/nvidia/cudnn/lib:$_RL_SP/nvidia/cufft/lib:$_RL_SP/nvidia/cufile/lib:$_RL_SP/nvidia/curand/lib:$_RL_SP/nvidia/cusolver/lib:$_RL_SP/nvidia/cusparse/lib:$_RL_SP/nvidia/cusparselt/lib:$_RL_SP/nvidia/nccl/lib:$_RL_SP/nvidia/nvjitlink/lib:$_RL_SP/nvidia/nvshmem/lib:$_RL_SP/nvidia/nvtx/lib:$_RL_SP/torch/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

# --- Sandbox egress when compute→login `ssh -D` is blocked (TOTP) ------------
# export PROXYCHAINS_BIN_OVERRIDE=$SCRATCH/tools/proxychains-ng-aarch64/bin/proxychains4
# export PROXYCHAINS_SOCKS5_PRESET_HOST=<login-node-ip>
# export PROXYCHAINS_SOCKS5_PRESET_PORT=1080
# export PROXYCHAINS_SOCKS5_PRESET_AUTH="<user> <pass>"   # keep this file 600
