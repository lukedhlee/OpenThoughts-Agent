export JSC_PROJECT=synthlaion
export JSC_HOME=/p/project1/synthlaion/lee27_jureca
export JSC_SCRATCH=/p/scratch/synthlaion/lee27

export DCFT=$JSC_HOME/code/OpenThoughts-Agent
export DCFT_PRIVATE=$DCFT
export DCFT_DATA=$JSC_SCRATCH
export DCFT_SCRATCH=$JSC_SCRATCH
export DCFT_GROUP=synthlaion

export WANDB_ENTITY=lukeleeai
export WANDB_PROJECT=OpenThoughts-Agent
export WANDB_DIR=$JSC_SCRATCH/wandb

export HF_HOME=$JSC_SCRATCH/cache/hf
export HF_HUB_CACHE=$HF_HOME/hub
export TORCH_HOME=$JSC_SCRATCH/cache/torch
export XDG_CACHE_HOME=$JSC_SCRATCH/cache
export PIP_CACHE_DIR=$JSC_SCRATCH/cache/pip
export UV_CACHE_DIR=$JSC_SCRATCH/cache/uv
export VLLM_CACHE_ROOT=$JSC_SCRATCH/cache/vllm
export TMPDIR=$JSC_SCRATCH/tmp

export DISABLE_VERSION_CHECK=1
export PATH=$HOME/.local/bin:$PATH

# MarinSkyRL + Harbor source trees live next to the OTA checkout on JURECA.
export RL_REPO_DIR=$JSC_HOME/code/MarinSkyRL
source "${DCFT_PRIVATE:-$DCFT}/hpc/shell_utils/resolve_rl_repo.sh"
export SKYRL_HOME="$(resolve_rl_repo_dir "$JSC_HOME/code")"

# Borrowed runtime shim overlays. These must precede site-packages so our
# regular `examples` package beats the unrelated installed `examples` package.
export JURECA_RL_SHIM=$JSC_SCRATCH/pythonpath
export JURECA_RL_PYOVERLAY=$JSC_SCRATCH/pyoverlay
export HARBOR_HOME=$JSC_HOME/code/harbor
export PYTHONPATH="$JURECA_RL_SHIM:$JURECA_RL_PYOVERLAY:${SKYRL_HOME}/skyrl-train:${HARBOR_HOME}/src:${DCFT_PRIVATE:-$DCFT}${PYTHONPATH:+:$PYTHONPATH}"

export EMAIL_ADDRESS="${EMAIL_ADDRESS:-}"
