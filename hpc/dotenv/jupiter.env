# lee27 personal Jupiter dotenv (reformo). Used by the lee27 scratch clone.
# Do not point at jureap59 / ot-baf — lee27 cannot read those paths.
export SCRATCH=/e/scratch/reformo/lee27
export DCFT=$SCRATCH/OpenThoughts-Agent
export DCFT_DATA=$SCRATCH/data
export DCFT_SCRATCH=$SCRATCH/otagent
export DC_AGENT_SECRET_ENV=$SCRATCH/keys/secrets.env
export DCFT_GROUP=reformo
export WANDB_PROJECT=jupiter-moe-gsm8k-grpo
export WANDB_MODE=offline
export WANDB_DIR=$SCRATCH/wandb
export HF_HUB_CACHE=$SCRATCH/cache/hf/hub
export HF_HOME=$SCRATCH/cache/hf
export CHECKPOINTS_DIR=$SCRATCH/checkpoints
export MODELS_DIR=$HF_HUB_CACHE
export DATASETS_DIR=$SCRATCH/data
export TOKENIZED_DATASETS_DIR=$DCFT_SCRATCH/tokenized_datasets
export VLLM_CACHE_ROOT=$SCRATCH/cache/vllm
export OT_AGENT_RAY_LOG_DIR=$SCRATCH/experiments/_ray_logs
export EXPERIMENTS_DIR=$SCRATCH/experiments
export DATA_DIR=$SCRATCH/data/gsm8k
export RL_REPO_DIR=$SCRATCH/MarinSkyRL
export SKYRL_HOME=$SCRATCH/MarinSkyRL
export DCFT_RL_ENV=$DCFT/envs/rl
export DISABLE_VERSION_CHECK=1
# Host venv (lee27 cannot read shared jureap59 SIF). Empty IMAGE => no Apptainer.
export IMAGE=
export LD_LIBRARY_PATH=/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cu13/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cublas/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cudnn/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cufft/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cufile/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/curand/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cusolver/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cusparse/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/cusparselt/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/nccl/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/nvjitlink/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/nvshmem/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/nvidia/nvtx/lib:/e/scratch/reformo/lee27/OpenThoughts-Agent/envs/rl/lib/python3.12/site-packages/torch/lib:/.singularity.d/libs:/usr/local/cuda/compat/lib.real:/usr/local/cuda-13/lib64/stubs:/usr/local/cuda/lib64/stubs:/usr/local/cuda-13/compat/lib.real/${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
export PYTHONPATH="${SKYRL_HOME}/skyrl-train:${SKYRL_HOME}/skyrl-gym:${DCFT}${PYTHONPATH:+:$PYTHONPATH}"
