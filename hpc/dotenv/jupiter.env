# lee27 personal Jupiter dotenv (reformo). Used by the lee27 fscratch clone.
# Do not point at jureap59 / ot-baf — lee27 cannot read those paths.
# 2026-08-14 relocation: /e/scratch/reformo is at its HARD inode limit (all writes
# EDQUOT) — everything lives under /e/fscratch now. /e/scratch is read-only legacy.
export SCRATCH=/e/fscratch/reformo/lee27
export DCFT=$SCRATCH/OpenThoughts-Agent
export DCFT_DATA=$SCRATCH/data
export DCFT_SCRATCH=$SCRATCH/otagent
export DC_AGENT_SECRET_ENV=$SCRATCH/keys/secrets.env
export DCFT_GROUP=reformo
export WANDB_PROJECT=jupiter-moe-gsm8k-grpo
export WANDB_MODE=offline
export WANDB_DIR=$SCRATCH/wandb
# Base-30B snapshot lives in $SCRATCH/hf_hub (not cache/hf/hub — copied there
# during the relocation); the rest of the HF cache stays under cache/hf.
export HF_HUB_CACHE=$SCRATCH/hf_hub
export HF_HOME=$SCRATCH/cache/hf
export CHECKPOINTS_DIR=$SCRATCH/checkpoints
export MODELS_DIR=$HF_HUB_CACHE
export DATASETS_DIR=$SCRATCH/data
export TOKENIZED_DATASETS_DIR=$DCFT_SCRATCH/tokenized_datasets
export VLLM_CACHE_ROOT=$SCRATCH/cache/vllm
# $HOME is over quota too — every cache consumer must land on fscratch.
export XDG_CACHE_HOME=$SCRATCH/cache/xdg
export TRITON_CACHE_DIR=$SCRATCH/cache/triton
export TORCHINDUCTOR_CACHE_DIR=$SCRATCH/cache/torchinductor
export FLASHINFER_WORKSPACE_BASE=$SCRATCH/cache/flashinfer
export OT_AGENT_RAY_LOG_DIR=$SCRATCH/experiments/_ray_logs
export EXPERIMENTS_DIR=$SCRATCH/experiments
export DATA_DIR=$SCRATCH/data/gsm8k
export RL_REPO_DIR=$SCRATCH/MarinSkyRL
export SKYRL_HOME=$SCRATCH/MarinSkyRL
# FA-enabled trainer env (rl-fa memo 2026-08-14); old envs/rl on /e/scratch is broken.
export DCFT_RL_ENV=$SCRATCH/envs/rl-fa
export DISABLE_VERSION_CHECK=1
# Host venv (lee27 cannot read shared jureap59 SIF). Empty IMAGE => no Apptainer.
export IMAGE=
_RL_SP=$DCFT_RL_ENV/lib/python3.12/site-packages
export LD_LIBRARY_PATH=$_RL_SP/nvidia/cu13/lib:$_RL_SP/nvidia/cublas/lib:$_RL_SP/nvidia/cuda_cupti/lib:$_RL_SP/nvidia/cuda_nvrtc/lib:$_RL_SP/nvidia/cuda_runtime/lib:$_RL_SP/nvidia/cudnn/lib:$_RL_SP/nvidia/cufft/lib:$_RL_SP/nvidia/cufile/lib:$_RL_SP/nvidia/curand/lib:$_RL_SP/nvidia/cusolver/lib:$_RL_SP/nvidia/cusparse/lib:$_RL_SP/nvidia/cusparselt/lib:$_RL_SP/nvidia/nccl/lib:$_RL_SP/nvidia/nvjitlink/lib:$_RL_SP/nvidia/nvshmem/lib:$_RL_SP/nvidia/nvtx/lib:$_RL_SP/torch/lib:/.singularity.d/libs:/usr/local/cuda/compat/lib.real:/usr/local/cuda-13/lib64/stubs:/usr/local/cuda/lib64/stubs:/usr/local/cuda-13/compat/lib.real/${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
export PYTHONPATH="${SKYRL_HOME}/skyrl-train:${SKYRL_HOME}/skyrl-gym:${DCFT}${PYTHONPATH:+:$PYTHONPATH}"
